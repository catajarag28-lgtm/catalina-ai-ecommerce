{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carolina-portfolio-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev sigue activo: la copia en GitHub Pages y los scripts de verificación lo usan.
  "workers_dev": true,
  "preview_urls": false,
  "observability":{ "enabled": true, "head_sampling_rate": 0.1 },
  // La web se sirve desde este mismo Worker en soycatalinajaramillo.com (build con `npm run deploy`).
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/health", "/carolina-control", "/carolina-control/data", "/session", "/chat", "/event", "/lead", "/propuesta/*", "/webhooks/resend", "/webhooks/instagram", "/ops/*", "/browser/*", "/interprete", "/interprete/*"] },
  "routes": [
    { "pattern": "soycatalinajaramillo.com", "custom_domain": true },
    { "pattern": "www.soycatalinajaramillo.com", "custom_domain": true }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://soycatalinajaramillo.com,https://www.soycatalinajaramillo.com,https://catajarag28-lgtm.github.io",
    "OUTREACH_ENABLED": "true",
    "OUTREACH_DAILY_LIMIT": "60",
    "OUTREACH_FIXED_DAILY_CAP": "false",
    "DIRECT_APPLICATIONS_ENABLED": "true",
    "DIRECT_APPLICATION_DAILY_LIMIT": "",
    "APPLICATION_EMAIL_FROM": "Catalina Jaramillo <catalina@soycatalinajaramillo.com>",
    "APPLICATION_REPLY_TO": "clientes@soycatalinajaramillo.com",
    "PROFILE_ES_URL": "https://soycatalinajaramillo.com/perfil-catalina.html",
    "PROFILE_EN_URL": "https://soycatalinajaramillo.com/catalina-profile.html",
    "INSTAGRAM_ENABLED": "false",
    "INSTAGRAM_API_VERSION": "v22.0",
    "PROSPECT_SOURCES": "[{\"url\":\"https://avaluxuryspa.com/\",\"region\":\"EE. UU.\",\"sector\":\"spa\"},{\"url\":\"https://refreshbymairi.com/es\",\"region\":\"EE. UU.\",\"sector\":\"spa\"},{\"url\":\"https://www.miamiinmobiliario.com/contacto/\",\"region\":\"EE. UU.\",\"sector\":\"inmobiliaria\"},{\"url\":\"https://www.awa-realty.com/\",\"region\":\"EE. UU.\",\"sector\":\"inmobiliaria\"},{\"url\":\"https://americanhubservices.com/es/nosotros/\",\"region\":\"EE. UU.\",\"sector\":\"servicios\"},{\"url\":\"https://professionalservicesgp.com/\",\"region\":\"EE. UU.\",\"sector\":\"servicios\"},{\"url\":\"https://www.lausi.es/contacto\",\"region\":\"España\",\"sector\":\"estética\"},{\"url\":\"https://centroauroom.es/contacto/\",\"region\":\"España\",\"sector\":\"estética\"},{\"url\":\"https://www.tablu.mx/pages/contacto\",\"region\":\"México\",\"sector\":\"ecommerce\"},{\"url\":\"https://www.aesthetic-center.mx/contacto\",\"region\":\"México\",\"sector\":\"estética\"},{\"url\":\"https://spaanamar.com/\",\"region\":\"Colombia\",\"sector\":\"spa\"}]",
    "CALENDAR_TIMEZONE": "America/Bogota",
    "GOOGLE_CALENDAR_ID": "catalinajaramillogirldo28@gmail.com",
    // Correos de Carolina a clientes vía Resend (secreto RESEND_API_KEY, dominio verificado en Resend).
    "EMAIL_FROM": "Catalina Jaramillo <clientes@soycatalinajaramillo.com>",
    "NOTIFY_FROM": "carolina@soycatalinajaramillo.com",
    "NOTIFY_TO": "catalinajaramillogirldo28@gmail.com",
    "CATALINA_EMAIL": "catalinajaramillogirldo28@gmail.com",
    "CATALINA_WHATSAPP": "+17869299442",
    "AUTO_SUBMIT": "on",
    "OPPORTUNITY_FORM_DAILY_LIMIT": "",
    "OUTREACH_MIN_DAILY_CAP": "10",
    "WHATSAPP_DAILY_PREP": "15",
    "JOBFEED_BRIEF_LIMIT": "20",
    "CONTACT_FORM_DAILY_LIMIT": "15",
    "PROPOSAL_PREP_DAILY_TARGET": "60",
    "APPLICATION_SUBMIT_DAILY_TARGET": "",
    "AI_DAILY_BUDGET_USD": "2",
    "AI_TASK_MAX_CALLS_15M": "50",
    "INTENT_SEARCHES_PER_SLOT": "5",
    "DEEP_RESEARCH_DAILY_TARGET": "40",
    "PREMIUM_REVIEW_DAILY_TARGET": "8",
    "MIN_CONTRACT_PRIORITY": "55",
    "MARKETPLACE_AUTOSUBMIT_ENABLED": "true",
    "FREELANCER_DAILY_BID_LIMIT": "",
    "FREELANCER_BID_SCOPE_VERIFIED": "true",
    "FREELANCER_FIRST_BID_VERIFIED": "false",
    "MARKETPLACE_MIN_USD": "500",
    "UPWORK_SUBMIT_PROPOSAL_ENABLED": "",
    "UPWORK_ADAPTER_READY": "",
    "BROWSER_AUTOMATION_ENABLED": "true",
    "CV_ES_URL": "https://soycatalinajaramillo.com/Catalina_Jaramillo_AI_Automation_Resume_2026.pdf",
    "CV_EN_URL": "https://soycatalinajaramillo.com/Catalina_Jaramillo_AI_Automation_Resume_2026_EN.pdf",
    "GOOGLE_BOOKING_URL": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ28En8b9c0EF2eETvQZOqyzsM1NcZSjhcwn-Zs12LMk7scnE1Mzf5ofci45A9K6AdG4yNo7gZOq?gv=true",
    "SENDER_POSTAL_ADDRESS": "Catalina Jaramillo · 14818 SW 180th Terrace, Miami, FL 33187, USA"
  },
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [{ "binding": "BROWSER_SESSIONS", "id": "fa58aaa0035a4618b36c5d608ae9ae4e" }],
  // Avisos de leads a Catalina vía Email Routing; el destino debe estar verificado en Cloudflare.
  "send_email": [{ "name": "NOTIFY", "destination_address": "catalinajaramillogirldo28@gmail.com" }],
  "d1_databases": [{ "binding": "DB", "database_name": "carolina-portfolio", "database_id": "67f1caa9-219a-45d1-b98a-7f7339fe7547" }],
  "triggers": { "crons": ["*/15 * * * *", "7,37 * * * *"] }
}


