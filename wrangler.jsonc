{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carolina-portfolio-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-29",
  // workers.dev sigue activo: la copia en GitHub Pages y los scripts de verificación lo usan.
  "workers_dev": true,
  "preview_urls": false,
  "observability":{ "enabled": true, "head_sampling_rate": 0.1 },
  // La web se sirve desde este mismo Worker en soycatalinajaramillo.com (build con `npm run deploy`).
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/health", "/session", "/chat", "/event", "/lead"] },
  "routes": [
    { "pattern": "soycatalinajaramillo.com", "custom_domain": true },
    { "pattern": "www.soycatalinajaramillo.com", "custom_domain": true }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://soycatalinajaramillo.com,https://www.soycatalinajaramillo.com,https://catajarag28-lgtm.github.io",
    "OPENROUTER_MODEL": "google/gemini-2.5-flash-lite",
    "OPENROUTER_EXTRACT_MODEL": "google/gemini-2.5-flash-lite",
    "CALENDAR_TIMEZONE": "America/Bogota",
    "NOTIFY_FROM": "carolina@soycatalinajaramillo.com",
    "NOTIFY_TO": "catajaragpyg@gmail.com"
  },
  // Avisos de leads a Catalina vía Email Routing; el destino debe estar verificado en Cloudflare.
  "send_email": [{ "name": "NOTIFY", "destination_address": "catajaragpyg@gmail.com" }],
  "d1_databases": [{ "binding": "DB", "database_name": "carolina-portfolio", "database_id": "67f1caa9-219a-45d1-b98a-7f7339fe7547" }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
