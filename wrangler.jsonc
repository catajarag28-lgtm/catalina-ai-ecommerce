{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carolina-portfolio-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-29",
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "ALLOWED_ORIGIN": "https://catajarag28-lgtm.github.io",
    "OPENROUTER_MODEL": "google/gemini-2.5-flash-lite",
    "OPENROUTER_EXTRACT_MODEL": "google/gemini-2.5-flash-lite",
    "CALENDAR_TIMEZONE": "America/Bogota"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "carolina-portfolio", "database_id": "67f1caa9-219a-45d1-b98a-7f7339fe7547" }],
  "triggers": { "crons": ["*/15 * * * *"] }
}

